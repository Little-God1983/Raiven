<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Raiven.Core\Raiven.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="KokoroSharp.CPU" Version="0.6.7" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets\raiven.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Assets\raiven-logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- KokoroSharp ships its voices/espeak data via a package target that copies
       AfterTargets="Build" into the build output only - dotnet publish never runs
       it, which shipped a mute RAIVEN. Carry those folders into the publish dir. -->
  <Target Name="PublishKokoroAssets" AfterTargets="Publish">
    <ItemGroup>
      <KokoroVoices Include="$(OutputPath)voices\**\*" />
      <KokoroEspeak Include="$(OutputPath)espeak\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(KokoroVoices)" DestinationFolder="$(PublishDir)voices\%(RecursiveDir)" />
    <Copy SourceFiles="@(KokoroEspeak)" DestinationFolder="$(PublishDir)espeak\%(RecursiveDir)" />
  </Target>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\raiven.ico</ApplicationIcon>
    <WindowsPackageType>None</WindowsPackageType>
    <AssemblyTitle>RAIVEN</AssemblyTitle>
    <Product>RAIVEN</Product>
  </PropertyGroup>

</Project>